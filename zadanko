
def gra():
    ekwipunek = {
        "miecz": 1,
        "mikstura": 3,
        "zloto": 50
    }

    ceny = {
        "miecz": 20,
        "mikstura": 10,
        "tarcza": 30,
        "luk": 25
    }

    wagi = {
        "miecz": 5,
        "mikstura": 0.5,
        "tarcza": 7,
        "luk": 2,
        "zloto": 0.01
    }

    max_waga = 30

    def oblicz_wage():
        suma = 0
        for nazwa, ilosc in ekwipunek.items():
            suma += wagi[nazwa] * ilosc
        return suma

    while True:
        print("\n===== MENU =====")
        print("1. Pokaz przedmioty")
        print("2. Kup przedmiot")
        print("3. Uzyj przedmiotu")
        print("4. Sprawdz przedmiot")
        print("5. Wyjdz")

        print(f"\nZloto: {ekwipunek['zloto']}")
        print(f"Waga: {oblicz_wage():.2f}/{max_waga} kg")

        wybor = input("\nWybierz opcje: ")

        if wybor == "1":
            print("\n===== EKWIPUNEK =====")

            for nazwa, ilosc in ekwipunek.items():
                print(
                    f"{nazwa}: {ilosc} szt. "
                    f"(waga: {wagi[nazwa] * ilosc:.2f} kg)"
                )

            print(f"\nZloto: {ekwipunek['zloto']}")
            print(f"Laczna waga: {oblicz_wage():.2f} kg")

        elif wybor == "2":
            print("\n===== SKLEP =====")

            for nazwa, cena in ceny.items():
                print(
                    f"{nazwa}: {cena} zlota "
                    f"| Waga: {wagi[nazwa]} kg"
                )

            przedmiot = input("\nCo chcesz kupic? ").lower()

            if przedmiot in ceny:
                cena = ceny[przedmiot]
                nowa_waga = oblicz_wage() + wagi[przedmiot]

                if ekwipunek["zloto"] < cena:
                    print("Nie masz wystarczajaco zlota!")

                elif nowa_waga > max_waga:
                    print("Nie masz miejsca w ekwipunku!")
                    print(f"Twoja waga: {oblicz_wage():.2f} kg")
                    print(f"Limit: {max_waga} kg")

                else:
                    ekwipunek["zloto"] -= cena

                    if przedmiot in ekwipunek:
                        ekwipunek[przedmiot] += 1
                    else:
                        ekwipunek[przedmiot] = 1

                    print(f"Kupiono {przedmiot} za {cena} zlota.")
                    print(f"Nowa waga: {oblicz_wage():.2f}/{max_waga} kg")

            else:
                print("Nie ma takiego przedmiotu w sklepie.")

        elif wybor == "3":
            przedmiot = input(
                "Jaki przedmiot chcesz uzyc/usunac? "
            ).lower()

            if przedmiot in ekwipunek and przedmiot != "zloto":
                ekwipunek[przedmiot] -= 1

                if ekwipunek[przedmiot] <= 0:
                    del ekwipunek[przedmiot]

                print("Uzyto przedmiotu.")
                print(f"Nowa waga: {oblicz_wage():.2f} kg")

            else:
                print("Nie masz takiego przedmiotu.")

        elif wybor == "4":
            przedmiot = input("Co sprawdzic? ").lower()

            if przedmiot in ekwipunek:
                ilosc = ekwipunek[przedmiot]
                print(f"Przedmiot: {przedmiot}")
                print(f"Ilosc: {ilosc}")
                print(f"Waga laczna: {wagi[przedmiot] * ilosc:.2f} kg")

            else:
                print("Nie ma tego w ekwipunku.")

        elif wybor == "5":
            print("Koniec.")
            break

        else:
            print("Zly wybor, wpisz cyfre od 1 do 5.")


gra()
