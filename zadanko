
def gra():
    ekwipunek = {
        "miecz": 1,
        "mikstura": 3,
        "zloto": 50
    }

    ceny = {
        "miecz": 20,
        "mikstura": 10,
        "tarcza": 30,
        "luk": 25
    }

    wagi = {
        "miecz": 5,
        "mikstura": 0.5,
        "tarcza": 7,
        "luk": 2,
        "zloto": 0.01
    }

    max_waga = 30

    def oblicz_wage():
        suma = 0
        for nazwa, ilosc in ekwipunek.items():
            suma += wagi[nazwa] * ilosc
        return suma

    while True:

        # STALE WIDOCZNE INFORMACJE
        print("\n" + "=" * 35)
        print("          TWOJA POSTAC")
        print("=" * 35)
        print(f"💰 ZLOTO: {ekwipunek['zloto']}")
        print(f"🎒 WAGA: {oblicz_wage():.2f} / {max_waga} kg")
        print("=" * 35)

        print("\n1. Pokaz przedmioty")
        print("2. Kup przedmiot")
        print("3. Uzyj przedmiotu")
        print("4. Sprawdz przedmiot")
        print("5. Wyjdz")

        wybor = input("\nWybierz opcje: ")

        if wybor == "1":
            print("\n--- EKWIPUNEK ---")

            for nazwa, ilosc in ekwipunek.items():
                print(
                    f"{nazwa}: {ilosc} szt. "
                    f"(waga: {wagi[nazwa] * ilosc:.2f} kg)"
                )

            input("\nNacisnij ENTER, aby wrocic do menu...")

        elif wybor == "2":
            print("\n--- SKLEP ---")

            for nazwa, cena in ceny.items():
                print(f"{nazwa}: {cena} zl | {wagi[nazwa]} kg")

            przedmiot = input("\nCo chcesz kupic? ").lower()

            if przedmiot in ceny:
                cena = ceny[przedmiot]

                if ekwipunek["zloto"] < cena:
                    print("Nie masz wystarczajaco zlota!")

                elif oblicz_wage() + wagi[przedmiot] > max_waga:
                    print("Przekroczysz limit 30 kg!")

                else:
                    ekwipunek["zloto"] -= cena

                    if przedmiot in ekwipunek:
                        ekwipunek[przedmiot] += 1
                    else:
                        ekwipunek[przedmiot] = 1

                    print(f"Kupiono: {przedmiot}")
                    print(f"Pozostalo zlota: {ekwipunek['zloto']}")

            else:
                print("Nie ma takiego przedmiotu!")

            input("\nNacisnij ENTER, aby wrocic do menu...")

        elif wybor == "3":
            przedmiot = input("\nCo chcesz uzyc? ").lower()

            if przedmiot in ekwipunek and przedmiot != "zloto":
                ekwipunek[przedmiot] -= 1

                if ekwipunek[przedmiot] == 0:
                    del ekwipunek[przedmiot]

                print("Uzyto przedmiotu!")

            else:
                print("Nie masz takiego przedmiotu!")

            input("\nNacisnij ENTER, aby wrocic do menu...")

        elif wybor == "4":
            przedmiot = input("\nCo sprawdzic? ").lower()

            if przedmiot in ekwipunek:
                print(f"\nPrzedmiot: {przedmiot}")
                print(f"Ilosc: {ekwipunek[przedmiot]}")
                print(
                    f"Waga: "
                    f"{wagi[przedmiot] * ekwipunek[przedmiot]:.2f} kg"
                )
            else:
                print("Nie masz tego przedmiotu!")

            input("\nNacisnij ENTER, aby wrocic do menu...")

        elif wybor == "5":
            print("\nKoniec gry!")
            break

        else:
            print("Nieprawidlowy wybor!")

            input("\nNacisnij ENTER, aby wrocic do menu...")


gra()
